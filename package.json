{
  "name": "@alexandercreates/localize-me",
  "version": "0.5.0",
  "description": "Schlanke Übersetzungsverwaltung für iOS- und Android-Apps: Keys anlegen, übersetzen, als Localizable.strings, strings.xml oder CSV exportieren.",
  "type": "module",
  "bin": {
    "localize-me": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "ui",
    "THIRD_PARTY_LICENSES"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "node bin/cli.js dev --file example/localize.json",
    "test": "node --test",
    "prepack": "npm run build",
    "postinstall": "node bin/postinstall.js",
    "prepublishOnly": "node scripts/check-release.js",
    "postversion": "git push --follow-tags"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.18"
  },
  "keywords": [
    "localization",
    "i18n",
    "translation",
    "ios",
    "android",
    "csv",
    "strings"
  ],
  "author": "alexandercreates",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandercreates/localize-me.git"
  },
  "bugs": {
    "url": "https://github.com/alexandercreates/localize-me/issues"
  },
  "homepage": "https://github.com/alexandercreates/localize-me#readme",
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.2",
    "vite": "^8.3.5"
  }
}
